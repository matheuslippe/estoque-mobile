SECRET_KEY=troque-por-uma-chave-secreta-gerada
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres local via docker-compose.yml (docker compose up -d)
# Sem esta variavel definida, o backend cai em SQLite (backend/db.sqlite3) so para dev sem Docker.
DATABASE_URL=postgres://estoque:estoque@localhost:5432/estoque

CORS_ALLOWED_ORIGINS=http://localhost:19006
