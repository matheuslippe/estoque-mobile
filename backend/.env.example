SECRET_KEY=troque-por-uma-chave-secreta-gerada
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.19

# Postgres local via docker-compose.yml (docker compose up -d)
# Sem esta variavel definida, o backend cai em SQLite (backend/db.sqlite3) so para dev sem Docker.
DATABASE_URL=postgres://estoque:estoque@localhost:5432/estoque

CORS_ALLOWED_ORIGINS=http://localhost:19006

# Bot Telegram + Gemini (deixe TELEGRAM_BOT_TOKEN vazio pra rodar sem o bot)
# TELEGRAM_BOT_TOKEN: crie um bot com o @BotFather no Telegram
# TELEGRAM_CHAT_IDS: lista separada por virgula dos chats autorizados a usar o bot (vazio = qualquer um, nao recomendado)
# GEMINI_API_KEY: https://aistudio.google.com/apikey
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
GEMINI_API_KEY=
BOT_API_BASE_URL=http://127.0.0.1:8000/api
BOT_API_USERNAME=bot
BOT_API_PASSWORD=troque-esta-senha-tambem
